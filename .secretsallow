# Narrow exemptions for the secret scanner (scripts/check-secrets.sh).
#
# One extended regex per line, matched against "path:line:text" for content
# findings and against the path for filename findings. Every entry needs a
# comment saying why it is safe.
#
# Rules of thumb:
#   * Exempt one line, not a rule and not a directory.
#   * If you cannot explain in a sentence why it is safe, it is not.
#   * Never reach for this to unblock a real credential. Rotate it instead.
#
# (Empty. Nothing in this repository has needed an exemption.)

# Test fixtures. Each is a literal that appears only in test code and is
# self-evidently not a credential — the value says so. Scoped to the exact
# string rather than to a file or a rule, so a real secret in the same file is
# still caught.

# server/auth.rs: the client secret of the stand-in provider in unit tests.
client_secret: "not-a-real-secret"

# server/auth.rs and server/session.rs: key-derivation inputs in tests. The
# length is the point of the fixture; the value is not secret.
"a-secret-of-entirely-adequate-length"
"a-test-secret-that-is-long-enough-to-use"
"a-different-secret-of-adequate-length"
"secret-number-(one|two)-long-enough-yes"

# tests/google_signin.rs: credentials of the local stand-in OIDC provider,
# which exists only inside the test binary.
CLIENT_SECRET: &str = "test-client-secret"

# tests/vectors/*.jwt: RS256 test vectors. These are signed tokens whose private
# key was generated once with OpenSSL and discarded — they authenticate nothing,
# grant nothing, and are verifiable with the public modulus sitting beside them.
# See tests/vectors/README.md.
#
# Anchored on all three of the path, the line number and the content actually
# being a JWT, so this cannot quietly exempt anything else that lands there.
^crates/web/tests/vectors/[a-z_]+\.jwt:1:eyJ[A-Za-z0-9_-]+\.eyJ[A-Za-z0-9_-]+\.
